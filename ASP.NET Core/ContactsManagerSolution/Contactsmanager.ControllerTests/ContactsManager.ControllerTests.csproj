<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="AutoFixture" Version="5.0.0-rc.1" />
	<PackageReference Include="coverlet.collector" Version="10.1.1">
	 <PrivateAssets>all</PrivateAssets>
	 <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="EntityFrameworkCoreMock.Moq" Version="4.0.0" />
	<PackageReference Include="Fizzler" Version="1.3.1" />
	<PackageReference Include="Fizzler.Systems.HtmlAgilityPack" Version="1.2.1" />
	<PackageReference Include="FluentAssertions" Version="8.11.0" />
	<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
	<PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="11.0.0" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
	<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
	<PackageReference Include="Moq" Version="4.21.0" />
	<PackageReference Include="StyleCop.Analyzers" Version="1.3.180">
	 <PrivateAssets>all</PrivateAssets>
	 <IncludeAssets>runtime; build; native; contentfiles; analyzers;buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
	 <PrivateAssets>all</PrivateAssets>
	 <IncludeAssets>runtime; build; native; contentfiles; analyzers;buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="xunit.v3" Version="4.0.3" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContactsManager.Core\ContactsManager.Core.csproj" />
    <ProjectReference Include="..\ContactsManager.UI\ContactsManager.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>